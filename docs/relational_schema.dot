digraph R {
graph [rankdir=LR, fontname="Helvetica", fontsize=22, labelloc=t, nodesep=0.35, ranksep=1.0, pad=0.4,
label="Relational Schema: 15 tables (PK = primary key, FK = foreign key, UK = unique / candidate key, UK* = part of a composite unique key)"];
node [shape=plaintext, fontname="Helvetica"]; edge [arrowhead=crow, arrowtail=tee, dir=both, color="#475569", penwidth=1.2];
SATELLITE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>SATELLITE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="satellite_id"><B><U>satellite_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="satellite_name">satellite_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="operator_name">operator_name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="launch_date">launch_date</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="orbit_type">orbit_type</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="sat_status">sat_status</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="revisit_days">revisit_days</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
SENSOR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#fff7e6"><B>SENSOR</B></TD></TR><TR><TD ALIGN="LEFT" PORT="sensor_id"><B><U>sensor_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="satellite_id">satellite_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sensor_name">sensor_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sensor_type">sensor_type</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="spatial_resolution_m">spatial_resolution_m</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="num_bands">num_bands</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
RIVER_BASIN [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>RIVER_BASIN</B></TD></TR><TR><TD ALIGN="LEFT" PORT="basin_id"><B><U>basin_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="basin_name">basin_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="basin_code">basin_code</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="river_ref_lat">river_ref_lat</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="river_ref_lon">river_ref_lon</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="area_sq_km">area_sq_km</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="basin_description">basin_description</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
LOCATION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>LOCATION</B></TD></TR><TR><TD ALIGN="LEFT" PORT="location_id"><B><U>location_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="basin_id">basin_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK (null)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="location_name">location_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="country">country</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="latitude">latitude</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="longitude">longitude</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="region_type">region_type</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
IMAGE_FRAME [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>IMAGE_FRAME</B></TD></TR><TR><TD ALIGN="LEFT" PORT="image_id"><B><U>image_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sensor_id">sensor_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK, UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="location_id">location_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK, UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capture_time">capture_time</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cloud_cover">cloud_cover</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="sun_elevation">sun_elevation</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="file_path">file_path</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="image_embedding">image_embedding</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="image_created_at">image_created_at</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
OBJECT_TYPE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>OBJECT_TYPE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="object_type_id"><B><U>object_type_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="type_name">type_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category">category</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="object_type_description">object_type_description</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
DETECTION_MODEL [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>DETECTION_MODEL</B></TD></TR><TR><TD ALIGN="LEFT" PORT="model_id"><B><U>model_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_name">model_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_version">model_version</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="architecture">architecture</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="trained_on">trained_on</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="released_date">released_date</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
DETECTED_OBJECT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>DETECTED_OBJECT</B></TD></TR><TR><TD ALIGN="LEFT" PORT="object_id"><B><U>object_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="image_id">image_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="object_type_id">object_type_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_id">model_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="confidence_score">confidence_score</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="bbox_min_lat">bbox_min_lat / min_lon</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="bbox_max_lat">bbox_max_lat / max_lon</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="area_sq_m">area_sq_m</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="object_embedding">object_embedding</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="attributes_json">attributes_json</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="object_created_at">object_created_at</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
OBJECT_CHANGE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#fde2e2"><B>OBJECT_CHANGE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="change_id"><B><U>change_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prev_object_id">prev_object_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK, UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="curr_object_id">curr_object_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK, UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="change_type">change_type</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">derived</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="change_pct">change_pct</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">derived</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="time_delta_days">time_delta_days</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">derived</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rate_pct_per_month">rate_pct_per_month</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">derived</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="computed_at">computed_at</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
SPECTRAL_INDEX [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#fff7e6"><B>SPECTRAL_INDEX</B></TD></TR><TR><TD ALIGN="LEFT" PORT="index_id"><B><U>index_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="image_id">image_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK, UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="index_name">index_name</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mean_value">mean_value</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="min_value">min_value</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="max_value">max_value</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
APP_USER [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>APP_USER</B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><B><U>user_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">UK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_role">user_role</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="user_created_at">user_created_at</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
QUERY_LOG [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>QUERY_LOG</B></TD></TR><TR><TD ALIGN="LEFT" PORT="query_id"><B><U>query_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK (null)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="query_text">query_text</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="query_embedding">query_embedding</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="submitted_at">submitted_at</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="response_text">response_text</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="retrieval_weights_json">retrieval_weights_json</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="aggregated_confidence">aggregated_confidence</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">derived</FONT></TD></TR></TABLE>>];
QUERY_EVIDENCE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#fde2e2"><B>QUERY_EVIDENCE</B></TD></TR><TR><TD ALIGN="LEFT" PORT="evidence_id"><B><U>evidence_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="query_id">query_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK, UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="object_id">object_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK, UK*</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="semantic_score">semantic_score</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="spatial_score">spatial_score</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="temporal_score">temporal_score</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="retrieval_score">retrieval_score</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">derived</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rank_position">rank_position</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
ALERT [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>ALERT</B></TD></TR><TR><TD ALIGN="LEFT" PORT="alert_id"><B><U>alert_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="change_id">change_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK, UK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="assigned_user_id">assigned_user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">FK (null)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="severity">severity</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="alert_status">alert_status</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="raised_at">raised_at</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="resolved_at">resolved_at</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
AUDIT_LOG [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>AUDIT_LOG</B></TD></TR><TR><TD ALIGN="LEFT" PORT="audit_id"><B><U>audit_id</U></B></TD><TD ALIGN="LEFT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="table_name">table_name</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="operation">operation</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="record_id">record_id</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="changed_by">changed_by</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="changed_at">changed_at</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="old_value">old_value</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" PORT="new_value">new_value</TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
SATELLITE:satellite_id -> SENSOR:satellite_id [];
SENSOR:sensor_id -> IMAGE_FRAME:sensor_id [];
LOCATION:location_id -> IMAGE_FRAME:location_id [];
RIVER_BASIN:basin_id -> LOCATION:basin_id [];
IMAGE_FRAME:image_id -> DETECTED_OBJECT:image_id [];
IMAGE_FRAME:image_id -> SPECTRAL_INDEX:image_id [];
OBJECT_TYPE:object_type_id -> DETECTED_OBJECT:object_type_id [];
DETECTION_MODEL:model_id -> DETECTED_OBJECT:model_id [];
DETECTED_OBJECT:object_id -> OBJECT_CHANGE:prev_object_id [];
DETECTED_OBJECT:object_id -> OBJECT_CHANGE:curr_object_id [];
DETECTED_OBJECT:object_id -> QUERY_EVIDENCE:object_id [];
QUERY_LOG:query_id -> QUERY_EVIDENCE:query_id [];
APP_USER:user_id -> QUERY_LOG:user_id [];
OBJECT_CHANGE:change_id -> ALERT:change_id [arrowhead=teeodot];
APP_USER:user_id -> ALERT:assigned_user_id [];
}